        window.calculateCalories = function() {
            const weight = parseFloat(document.getElementById('weight').value) || 55;
            const height = parseFloat(document.getElementById('height').value) || 170;
            const age = parseInt(document.getElementById('age').value) || 25;
            const gender = document.getElementById('gender').value;
            const activity = parseFloat(document.getElementById('activity').value) || 1.375;

            let bmr = (10 * weight) + (6.25 * height) - (5 * age);
            bmr += (gender === 'male' ? 5 : -161);

            const maintenance = Math.round(bmr * activity);
            const target = maintenance + 400; // Bulking surplus

            document.getElementById('maintenanceVal').innerText = maintenance + ' kcal';
            document.getElementById('targetVal').innerText = target + ' kcal';
            document.getElementById('resultBox').classList.remove('hidden');
        };

