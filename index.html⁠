                let cal = Math.floor(Math.random() * 300) + 200;
                foodItems.push({ name: name, cal: cal });
                document.getElementById('foodName').value = '';
                renderFoodTable();
            }, 800);
        };

        window.deleteFoodItem = function(index) {
            foodItems.splice(index, 1);
            renderFoodTable();
        };

        function renderFoodTable() {
            const tbody = document.getElementById('foodTableBody');
            tbody.innerHTML = '';
            let total = 0;
            foodItems.forEach((item, idx) => {
                total += item.cal;
                tbody.innerHTML += `
                    <tr class="border-b border-slate-200/60 dark:border-slate-700/60 hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                        <td class="p-4 font-semibold text-slate-800 dark:text-slate-200">${item.name}</td>
                        <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold">${item.cal} kcal</td>
                        <td class="p-4 text-center"><button type="button" onclick="deleteFoodItem(${idx})" class="text-rose-500 hover:text-rose-700 text-xs font-bold px-3 py-1 bg-rose-50 dark:bg-rose-950/50 rounded-lg">✕ ဖျက်ရန်</button></td>
                    </tr>
                `;
            });
            document.getElementById('totalConsumed').innerText = total + ' kcal';
        }

        window.saveTodayHistory = function() {
            let total = foodItems.reduce((acc, curr) => acc + curr.cal, 0);
            let history = JSON.parse(localStorage.getItem('history') || '[]');
            history.unshift({ date: new Date().toLocaleDateString(), total: total });
            localStorage.setItem('history', JSON.stringify(history));
            renderHistory();
            alert(currentLang === 'my' ? 'ယနေ့အတွက် မှတ်တမ်းသိမ်းဆည်းပြီးပါပြီ' : 'Saved successfully');
        };

        function renderHistory() {
            let history = JSON.parse(localStorage.getItem('history') || '[]');
            const container = document.getElementById('historyContainer');
            container.innerHTML = '';
            if (history.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-500">${currentLang === 'my' ? 'မှတ်တမ်းမရှိသေးပါ' : 'No history yet'}</p>`;
                return;
            }
            history.forEach(h => {
                container.innerHTML += `
                    <div class="p-4 bg-white/80 dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 flex justify-between items-center text-xs sm:text-sm font-semibold">
                        <span class="text-slate-700 dark:text-slate-300">📅 ${h.date}</span>
                        <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">${h.total} kcal</span>
                    </div>
                `;
            });
        }

        window.clearHistory = function() {
            localStorage.removeItem('history');
            renderHistory();
        };

        window.logSleep = function() {
            const hrs = document.getElementById('sleepHoursInput').value;
            alert(currentLang === 'my' ? `အိပ်ချိန် ${hrs} နာရီ မှတ်တမ်းတင်ပြီးပါပြီ။ ကြွက်သားပြန်လည်ကောင်းမွန်ရန် အလွန်ကောင်းမွန်ပါသည်။` : `Logged ${hrs} hours of sleep successfully.`);
        };

        window.calculateWater = function() {
            const w = parseFloat(document.getElementById('waterWeightInput').value) || 55;
            targetGlasses = Math.round((w * 35) / 250); // ~35ml per kg, 250ml per glass
            document.getElementById('targetWaterVal').innerText = `${((targetGlasses * 250) / 1000).toFixed(1)} လီတာ (ခွက်ပေါင်း ${targetGlasses} ခွက်)`;
            document.getElementById('consumedWaterVal').innerText = `သောက်ပြီး: ${waterGlasses} / ${targetGlasses} ခွက်`;
        };

        window.addWaterGlass = function() {
            if (waterGlasses < targetGlasses) waterGlasses++;
            document.getElementById('consumedWaterVal').innerText = `သောက်ပြီး: ${waterGlasses} / ${targetGlasses} ခွက်`;
        };

        window.resetWater = function() {
            waterGlasses = 0;
            document.getElementById('consumedWaterVal').innerText = `သောက်ပြီး: ${waterGlasses} / ${targetGlasses} ခွက်`;
        };

        const roadMapData = [
            { day: 1, meal: 'ထမင်း၊ ကြက်ဥပြုတ် ၂ လုံး၊ ပဲဟင်း', workout: 'အပေါ့စား အကြောဆန့်ခြင်း (Stretching)', sleep: 'အနည်းဆုံး ၈ နာရီပြည့်ဝစွာ အိပ်ပါ' },
            { day: 2, meal: 'ထမင်း၊ ဝက်သားဟင်း၊ ဒိန်ချဉ်', workout: 'အိမ်တွင်း လက်ထိုးခြင်း (Push-ups) ၃ ဆင့်', sleep: 'ည ၁၀ နာရီတိတိ အိပ်ရာဝင်ပါ' },
            { day: 3, meal: 'အုတ်ဂျုံ၊ ငှက်ပျောသီး ၂ လုံး၊ နို့', workout: 'ဝိတ်တုံးအပေါ့စားဖြင့် ကြွက်သားလေ့ကျင့်ခန်း', sleep: 'အိပ်ရေးဝဝ အိပ်စက်ပါ' },
            { day: 4, meal: 'ထမင်း၊ ငါးဟင်း၊ ဟင်းရွက်စုံ', workout: 'အနားယူသည့်ရက် (Rest Day)', sleep: 'အနည်းဆုံး ၈ နာရီ အိပ်ပါ' },
            { day: 5, meal: 'ပေါင်မုန့်၊ မြေပဲထောပတ်၊ ကြက်ဥ', workout: 'ဝမ်းဗိုက်နှင့် ကိုယ်ထည်ကြံ့ခိုင်ရေး', sleep: 'အိပ်ချိန်မှန်ကန်စေရန် လုပ်ဆောင်ပါ' },
        ];

        function initRoadmap() {
            const selector = document.getElementById('daySelector');
            selector.innerHTML = '';
            for (let i = 1; i <= 30; i++) {
                selector.innerHTML += `<option value="${i}">Day ${i}</option>`;
            }
            renderDayPlan();
        }

        window.renderDayPlan = function() {
            const dayNum = parseInt(document.getElementById('daySelector').value) || 1;
            const data = roadMapData[(dayNum - 1) % roadMapData.length];
            document.getElementById('dayHeading').innerText = `Day ${dayNum}: ${currentLang === 'my' ? 'အသားတက်ရန် နေ့စဥ်အစီအစဥ်' : 'Daily Bulking Plan'}`;
            document.getElementById('dayMealText').innerText = data.meal;
            document.getElementById('dayWorkoutText').innerText = data.workout;
            document.getElementById('daySleepText').innerText = data.sleep;
        };

        document.addEventListener('DOMContentLoaded', function() {
            if (localStorage.getItem('theme') === 'dark') {
                document.getElementById('appBody')?.classList.add('dark');
                const themeIcon = document.getElementById('themeIcon');
                const themeText = document.getElementById('themeText');
                if (themeIcon) themeIcon.innerText = '☀️';
                if (themeText) themeText.innerText = currentLang === 'my' ? 'အဖြူ' : 'Light';
            }

            window.checkLoginState();
            updateLanguageUI();
            initRoadmap();
            renderHistory();
        });
    </script>
</body>
</html>
